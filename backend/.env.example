# ==============================================================================
# DEALFLOW360 BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Duplicate this file as '.env' in the backend root directory:
#   cp .env.example .env
# Fill in your local or production credentials below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
# Application connection string (RLS-enforced user)
DATABASE_URL=postgresql://dealflow_app_user:StrongPassword123@localhost:5432/deal_flow

# Admin / Superuser connection string (used for running migrations, schema setup, and seeders)
ADMIN_DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/deal_flow

# ------------------------------------------------------------------------------
# 3. REDIS & BACKGROUND QUEUES (BULLMQ)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & ENCRYPTION SECRETS
# ------------------------------------------------------------------------------
# In production, replace these with cryptographically random 64-character strings:
# e.g., run in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dealflow360_default_jwt_secret_dev_key
SESSION_SECRET=dealflow360_enterprise_session_secret_2026

# Token expiration windows
STAFF_JWT_EXPIRES_IN=7d
PORTAL_JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 5. CLIENT APPS & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for web clients & socket.io
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# URLs used in email notifications, magic links, and redirects
FRONTEND_STAFF_URL=http://localhost:3000
FRONTEND_PORTAL_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (RAZORPAY)
# ------------------------------------------------------------------------------
# Obtain your API keys from: https://dashboard.razorpay.com/app/keys (Toggle 'Test Mode' for development)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_CURRENCY=INR

# ------------------------------------------------------------------------------
# 7. EMAIL & NOTIFICATIONS (SMTP / NODEMAILER)
# ------------------------------------------------------------------------------
# Default development uses Mailtrap (https://mailtrap.io). In production, configure Gmail, SendGrid, or AWS SES.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
# Optional service preset: gmail
# SMTP_SERVICE=gmail
SMTP_FROM="DealFlow360 Operations" <no-reply@dealflow360.internal>

# Inbound RFQ notifications
ENABLE_RFQ_EMAIL_NOTIFICATIONS=false
SALES_REP_ALERT_EMAIL=sales-ops@dealflow360.internal

# ------------------------------------------------------------------------------
# 8. TELEMETRY & LOGGING (GRAFANA LOKI)
# ------------------------------------------------------------------------------
LOKI_URL=http://localhost:3100/loki/api/v1/push
