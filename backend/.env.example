# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# CRITICAL (Section 4.1): Connect as a NON-OWNER login role that is a member of
# 'app_role_staff' and 'app_role_customer_portal' (e.g. 'dealflow_app_user').
# If the app connects as postgres/superuser or table owner, Postgres bypasses RLS and column grants!
DATABASE_URL=postgresql://dealflow_app_user:StrongPassword123@localhost:5432/dealflow360

# Optional administrative connection string for running DDL / schema setup or migrations
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealflow360

# Authentication Secrets
JWT_SECRET=super_secret_dealflow360_signing_key_2026_change_in_production
STAFF_JWT_EXPIRES_IN=7d
PORTAL_JWT_EXPIRES_IN=24h

# SMTP Email Configuration (Nodemailer for Magic Links and RFQ Notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="DealFlow360 Operations <no-reply@dealflow360.internal>"

# CORS Allowed Frontend Origins
FRONTEND_STAFF_URL=http://localhost:3000
FRONTEND_PORTAL_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
